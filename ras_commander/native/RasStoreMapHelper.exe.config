<?xml version="1.0" encoding="utf-8"?>
<!--
  RasStoreMapHelper runs against the HEC-RAS mapping runtime through
  Assembly.LoadFrom. When the helper executable itself sits on a network
  location (an SMB/UNC share on Windows, an NFS mount inside a container, or
  Wine's network-typed Z: drive), the CLR treats it as a remote assembly and
  refuses to load its dependencies with:

      Could not load file or assembly 'file:///...RasMapperLib.dll' or one of
      its dependencies. Operation is not supported.
      (Exception from HRESULT: 0x80131515)

  loadFromRemoteSources restores full trust for those loads so stored maps work
  for projects and installations reached over a network filesystem.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
